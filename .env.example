# Supabase Realtime powers the studio <-> phone connection.
# Netlify has no long-lived WebSocket process, so realtime broadcast channels
# replace the old socket.io server. Any Supabase project works; no tables or
# schema are required.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-key"

# Optional. Powers the AI copilot panel; without it the curated fallbacks are used.
GEMINI_API_KEY="your-gemini-key"

# Only needed to regenerate the 3D models (npm run models:generate).
MESHY_API_KEY="your-meshy-key"

# The admin dashboard and the launch database. All three are set in Netlify
# (Functions scope, secret), never here — they are listed only so you know the
# names. Without them /admin returns 503 and the site runs exactly as before.
# ADMIN_PASSWORD="shared password for /admin and /admin/review"
# ADMIN_SESSION_SECRET="at least 24 characters; signs the admin session cookie"
# NETLIFY_DB_URL="provisioned by Netlify Database; holds settings, feedback and analytics"
